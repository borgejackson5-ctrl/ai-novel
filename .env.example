# ============================================================
# ai-novel 环境变量示例（复制为 .env 后按需修改，.env 已被 gitignore）
# docker compose 会自动读取同目录 .env 填充 ${VAR}
#
# 生产请直接跑 deploy/gen-env.sh —— 它会生成随机强口令并写好 .env。
# 本文件是「手工填」用的模板：口令一律留空，**不要**把真实口令写回这里（本文件入库）。
# docker-compose.prod.yml 用的是 ${VAR:?...}，缺变量会直接报错退出，
# 不会静默退回弱口令 —— 所以留空是安全的，只是起不来。
# ============================================================

# MySQL（必填。本地随意填一个即可，如 dev-local-mysql；生产用随机强口令）
MYSQL_ROOT_PASSWORD=

# Redis（必填。本地如 dev-local-redis；生产用随机强口令）
REDIS_PASSWORD=

# RabbitMQ（必填。本地如 guest/guest；生产用随机强口令）
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Druid 监控台口令（application.yaml 读取，生产建议关闭监控台）
DRUID_USER=druid
DRUID_PASSWORD=druid

# AI 服务（留空自动降级 Mock）
AI_API_KEY=

# CORS 白名单（逗号分隔，禁止 *）
# 生产同源（nginx 反代 /api）时此值不影响；如需公网直连后端再改为 http://<公网IP>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 支付回调验签密钥（生产必填强随机值，勿空、勿写死进代码）
PAY_NOTIFY_SECRET=change-me-to-a-strong-random-secret

# Elasticsearch 数据目录（默认 ./docker-data/elasticsearch，位于项目内；
# 如希望索引落到指定磁盘，取消注释并改为绝对路径即可）
# ES_DATA_DIR=D:/docker-data/ai-novel/elasticsearch
